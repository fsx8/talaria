{
  "name": "talaria-spa",
  "private": true,
  "version": "0.3.0",
  "description": "Talaria — the unofficial Thunderbird web client (Phase 2+ Round 2): Vue 3 PWA mail-triage surface with a daisyUI theme system and settings, served by the sidecar.",
  "type": "module",
  "license": "MPL-2.0",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "shots": "node scripts/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@tanstack/vue-virtual": "^3.13.54",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/vue-3": "^3.35.0",
    "dompurify": "^3.5.0",
    "marked": "^18.2.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "daisyui": "^5.8.2",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
